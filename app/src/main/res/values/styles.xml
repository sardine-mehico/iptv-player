<resources>
    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text.Secondary" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext|flagNoExtractUi</item>
    </style>

    <style name="TileButton" parent="">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Full-screen player buttons: flat, compact, focus shown by the tile border. -->
    <style name="ControlButton" parent="TileButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Home menu tile: icon above label, one flat view. -->
    <style name="HomeTile" parent="TileButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">180dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:drawableTint">@color/text_primary</item>
        <item name="android:paddingTop">28dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Search field at the top of a category list. -->
    <style name="SearchInput" parent="Input">
        <item name="android:layout_height">44dp</item>
        <item name="android:hint">@string/search</item>
        <item name="android:imeOptions">actionSearch|flagNoExtractUi</item>
        <item name="android:inputType">text|textNoSuggestions</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Icon-only player button (play/pause, previous/next). Same size and focus look as ControlButton. -->
    <style name="ControlIcon">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_primary</item>
    </style>

    <!-- Compact home button (Settings, Reload playlist): icon left of the label. -->
    <style name="HomeSmallTile" parent="TileButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/text_primary</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:maxLines">2</item>
    </style>
</resources>
