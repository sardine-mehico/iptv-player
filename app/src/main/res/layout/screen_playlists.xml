<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- App Settings, in sections. Scrolls on short screens and with many playlists. -->
    <ScrollView
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipToPadding="false"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings" />

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_hint"
            android:textSize="14sp" />

        <TextView style="@style/Text.Section" android:text="@string/section_home" />
        <include android:id="@+id/default_home" layout="@layout/row_setting" />
        <include android:id="@+id/slot_count" layout="@layout/row_setting" />

        <TextView style="@style/Text.Section" android:text="@string/section_startup" />
        <include android:id="@+id/auto_start" layout="@layout/row_setting" />

        <TextView style="@style/Text.Section" android:text="@string/section_network" />
        <include android:id="@+id/dns" layout="@layout/row_setting" />

        <TextView style="@style/Text.Section" android:text="@string/section_shortcuts" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/all_apps"
                style="@style/TileButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/all_apps" />

            <TextView
                android:id="@+id/android_settings"
                style="@style/TileButton"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/android_settings" />
        </LinearLayout>

        <TextView style="@style/Text.Section" android:text="@string/playlists" />
        <TextView
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="4dp"
            android:text="@string/playlists_hint"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/add"
            style="@style/TileButton"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:text="@string/add_playlist" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:minHeight="24dp"
            android:orientation="horizontal">

            <!-- Shown only while a playlist loads. -->
            <io.github.sardinemehico.iptvplayer.ui.LoadingDots
                android:id="@+id/busy"
                android:layout_width="40dp"
                android:layout_height="10dp"
                android:layout_marginEnd="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/message"
                style="@style/Text.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>
