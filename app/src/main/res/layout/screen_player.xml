<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen movie/episode player. Transparent: the shared PlayerView shows through. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true">

    <TextView
        android:id="@+id/osd_status"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/scrim"
        android:padding="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/scrim"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="20dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/title"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/position"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp" />

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressBackgroundTint="@color/divider"
                android:progressTint="@color/accent" />

            <TextView
                android:id="@+id/duration"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="72dp" />
        </LinearLayout>

        <!-- Scrolls if the buttons don't fit (series show two extra). -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/ctl_prev" style="@style/ControlButton" android:text="@string/ctl_prev_ep" />
            <TextView android:id="@+id/ctl_back" style="@style/ControlButton" android:text="@string/ctl_rewind" />
            <TextView android:id="@+id/ctl_pause" style="@style/ControlButton" android:text="@string/ctl_pause" />
            <TextView android:id="@+id/ctl_fwd" style="@style/ControlButton" android:text="@string/ctl_forward" />
            <TextView android:id="@+id/ctl_next" style="@style/ControlButton" android:text="@string/ctl_next_ep" />
            <TextView android:id="@+id/ctl_audio" style="@style/ControlButton" android:text="@string/ctl_audio" />
            <TextView android:id="@+id/ctl_subs" style="@style/ControlButton" android:text="@string/ctl_subs" />
            <TextView android:id="@+id/ctl_aspect" style="@style/ControlButton" android:text="@string/ctl_aspect_fit" />
        </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
