<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_playlist" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mode_xtream"
                style="@style/TileButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/mode_xtream" />

            <TextView
                android:id="@+id/mode_m3u"
                style="@style/TileButton"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/mode_m3u" />
        </LinearLayout>

        <EditText
            android:id="@+id/name"
            style="@style/Input"
            android:hint="@string/hint_name"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/server"
            style="@style/Input"
            android:hint="@string/hint_server"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/username"
            style="@style/Input"
            android:hint="@string/hint_username"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions|textVisiblePassword" />

        <EditText
            android:id="@+id/password"
            style="@style/Input"
            android:hint="@string/hint_password"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions|textVisiblePassword" />

        <EditText
            android:id="@+id/m3u_url"
            style="@style/Input"
            android:hint="@string/hint_m3u"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/save"
            style="@style/TileButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="@string/save_and_load" />
    </LinearLayout>
</FrameLayout>
