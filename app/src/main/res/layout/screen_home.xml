<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="36dp"
    android:paddingEnd="48dp">

    <TextView
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name" />

    <TextView
        android:id="@+id/account"
        style="@style/Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tile_live"
            style="@style/HomeTile"
            android:drawableTop="@drawable/ic_live_tv"
            android:text="@string/live_tv" />

        <TextView
            android:id="@+id/tile_movies"
            style="@style/HomeTile"
            android:layout_marginStart="20dp"
            android:drawableTop="@drawable/ic_movies"
            android:text="@string/movies" />

        <TextView
            android:id="@+id/tile_series"
            style="@style/HomeTile"
            android:layout_marginStart="20dp"
            android:drawableTop="@drawable/ic_series"
            android:text="@string/series" />

        <TextView
            android:id="@+id/tile_settings"
            style="@style/HomeTile"
            android:layout_marginStart="20dp"
            android:drawableTop="@drawable/ic_settings"
            android:text="@string/settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/version"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingBottom="20dp"
        android:textSize="14sp" />
</LinearLayout>
