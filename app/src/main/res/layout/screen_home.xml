<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="36dp"
    android:paddingEnd="48dp">

    <TextView
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name" />

    <TextView
        android:id="@+id/account"
        style="@style/Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <!-- Reload progress: shown only while a reload runs, and for its result. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:minHeight="24dp"
        android:orientation="horizontal">

        <io.github.sardinemehico.iptvplayer.ui.LoadingDots
            android:id="@+id/busy"
            android:layout_width="40dp"
            android:layout_height="10dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reload_status"
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Big tiles, then the app slots, centred in the space left. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tile_live"
            style="@style/HomeTile"
            android:drawableTop="@drawable/ic_live_tv"
            android:text="@string/live_tv" />

        <TextView
            android:id="@+id/tile_movies"
            style="@style/HomeTile"
            android:layout_marginStart="20dp"
            android:drawableTop="@drawable/ic_movies"
            android:text="@string/movies" />

        <TextView
            android:id="@+id/tile_series"
            style="@style/HomeTile"
            android:layout_marginStart="20dp"
            android:drawableTop="@drawable/ic_series"
            android:text="@string/series" />

        <!-- Smaller column: Settings and Reload playlist, together as tall as one big tile. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginStart="20dp"
            android:layout_weight="0.8"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tile_settings"
                style="@style/HomeSmallTile"
                android:drawableStart="@drawable/ic_settings_small"
                android:text="@string/settings" />

            <TextView
                android:id="@+id/tile_reload"
                style="@style/HomeSmallTile"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_refresh"
                android:text="@string/reload_playlist" />
        </LinearLayout>
    </LinearLayout>

    <!-- Five app slots the user fills, like Android TV's favourite apps row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/app_slot_0"
            layout="@layout/row_app_slot"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/app_slot_1"
            layout="@layout/row_app_slot"
            android:layout_marginStart="16dp"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/app_slot_2"
            layout="@layout/row_app_slot"
            android:layout_marginStart="16dp"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/app_slot_3"
            layout="@layout/row_app_slot"
            android:layout_marginStart="16dp"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/app_slot_4"
            layout="@layout/row_app_slot"
            android:layout_marginStart="16dp"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1" />
    </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/version"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingBottom="20dp"
        android:textSize="14sp" />
</LinearLayout>
